# Night Crawlers — frontend environment variables
#
# Copy this file to `.env.local` and fill in the values.
# `.env.local` is gitignored; this file is committed as the reference.

# ─── Backend API ─────────────────────────────────────────────────────────────
#
# DEVELOPMENT: leave this EMPTY / commented out.
#   The dev server proxies /api to VITE_DEV_API_PROXY (see vite.config.ts),
#   which avoids CORS entirely while you work locally.
#
# PRODUCTION (Vercel / Netlify): set this to the full backend origin.
#   The backend must allow this site's origin via CORS, with credentials.
#
# VITE_API_BASE_URL=https://api.nightcrawlers.com

# ─── Local dev proxy target ──────────────────────────────────────────────────
#
# Where the dev server forwards /api requests. Change this to whatever port
# the backend runs on locally. Defaults to http://localhost:5000.

VITE_DEV_API_PROXY=https://api.nightcrawlers.app/
